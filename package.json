{
    "name": "@packsnap/whatnot-sdk",
    "version": "0.1.1",
    "description": "Community TypeScript SDK for the Whatnot Seller API, maintained by PackSnap",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/packsnaphq/whatnot-sdk.git"
    },
    "homepage": "https://github.com/packsnaphq/whatnot-sdk#readme",
    "bugs": {
        "url": "https://github.com/packsnaphq/whatnot-sdk/issues"
    },
    "license": "MIT",
    "author": "PackSnap",
    "keywords": [
        "whatnot",
        "sdk",
        "oauth",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "lint": "eslint src tests scripts && prettier --check .",
        "format": "prettier --write .",
        "generate": "node scripts/generate-types.mjs",
        "prepare": "npm run build",
        "prepack": "npm run build"
    },
    "dependencies": {
        "ky": "^2.2.0",
        "oauth4webapi": "^3.8.9"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.5",
        "eslint": "^9.39.5",
        "globals": "^17.14.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.10.1",
        "semver": "^7.8.6",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0"
    }
}
