{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "dist"
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
